<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase C 재구축 연속 백그라운드 잡 — scripts/phase_c_rebuild.py --managed
  ==================================================================
  계획 = docs/plans/loop-vivid-bubble.md (D2=연속 백그라운드 잡). 파싱은 24/7 무인 가능하므로
  야간 한정이 아니라 **연속 실행**한다. rebuild_target_track1 을 corp 순차·기업 원자커밋으로
  version=2 재구축한다(소비계층 v1 무영향, Phase D 검증 후 swap).

  동작:
    - RunAtLoad=true 로 로드 즉시 시작. 한 번의 실행이 남은 pending 기업을 전부 처리한다
      (내부 루프, 기업 단위 커밋 = 재개 안전).
    - KeepAlive.SuccessfulExit=false: **비정상 종료(크래시·재부팅·sleep)에만 재시작**해서
      이어서 처리. 정상 완주(exit 0)면 재시작하지 않는다.
    - --managed: 대상 전량 done/held 로 pending 0 이 되면 스스로 launchctl bootout + 이 plist
      삭제(gapfill 선례). 더 이상 등록/실행 없음.

  ⚠ 설치는 파일럿 검증 + note 추출층 v2 배선(Task 6) 완료 후. 설치:
    cp deploy/launchd/com.tjfinance.phasec.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tjfinance.phasec.plist
  ⚠ collect/gapfill 잡은 Phase C 동안 중지 유지(재구축 오염 방지). 완료 후 복구.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tjfinance.phasec</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/taejin/Project/tj_finance/.venv/bin/python</string>
        <string>/Users/taejin/Project/tj_finance/scripts/phase_c_rebuild.py</string>
        <string>--managed</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/taejin/Project/tj_finance</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- 비정상 종료에만 재시작(정상 완주 시 재시작 안 함). 재시작 간 최소 60초. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/taejin/Project/tj_finance/logs/phase_c.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/taejin/Project/tj_finance/logs/phase_c.err.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  계층2 전량적재 연속 백그라운드 잡 — scripts/load_report_lines.py --managed
  ========================================================================
  계획 = docs/plans/rearchitecture_4layer_2026-07-19.md §진행순서 1차 패스
  (2015+ 원본 XML → report_lines). 파싱은 무인 가능하므로 연속 실행한다.

  동작:
    - RunAtLoad=true 로 로드 즉시 시작. 한 번의 실행이 남은 대상을 전부 처리한다
      (내부 루프, 200건 단위 커밋 = 재개 안전).
    - KeepAlive.SuccessfulExit=false: **비정상 종료(크래시·재부팅·sleep 복귀)에만 재시작**해
      report_line_load_progress 기준으로 이어서 처리. 정상 완주(exit 0)면 재시작 안 함.
    - --managed: 남은 대상 0 이 되면 스스로 launchctl bootout + 이 plist 삭제
      (gapfill·phasec 선례). 더 이상 등록/실행 없음.

  실측 근거(착수 전):
    대상 102,633건 · 3.8건/s → 약 7.5시간 · 62M행 · 약 30GB
    (DB 는 내장 SSD /opt/homebrew/var/postgresql@15, 여유 87GB — 외장 dart_data 아님)

  ⚠ 주석은 제외(include_notes=False). 포함 시 볼륨 5배(~150GB)로 디스크에 들어가지 않는다.
  ⚠ collect/gapfill 잡은 재구축 기간 중지 유지([[nightly-jobs-paused-phase-a3]]).

  설치:
    cp deploy/launchd/com.tjfinance.layer2load.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tjfinance.layer2load.plist
  진행 확인:
    python scripts/load_report_lines.py --status
    tail -f logs/layer2_load.err.log
  중지:
    launchctl bootout gui/$(id -u)/com.tjfinance.layer2load
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tjfinance.layer2load</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/taejin/Project/tj_finance/.venv_tj_finance/bin/python</string>
        <string>/Users/taejin/Project/tj_finance/scripts/load_report_lines.py</string>
        <string>--managed</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/taejin/Project/tj_finance</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- 비정상 종료에만 재시작(정상 완주 시 재시작 안 함). 재시작 간 최소 60초. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/taejin/Project/tj_finance/logs/layer2_load.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/taejin/Project/tj_finance/logs/layer2_load.err.log</string>
</dict>
</plist>

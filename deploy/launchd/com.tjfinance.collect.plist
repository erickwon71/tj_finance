<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  매일 18:00 신규 공시 수집·DB화 자동 실행 (launchd LaunchAgent).
  ※ 위 DOCTYPE 은 필수다 — 빠지면 `plutil -lint` 는 OK 를 내지만 launchd 는
    `Bootstrap failed: 5: Input/output error` 로 거부한다(2026-07-31 실제 겪음).
  잠자기 상태면 pmset 예약 wake(17:58)로 깨운 뒤 launchd 가 18:00 에 실행한다.
  설치: deploy/launchd/README 또는 대화 안내 참조.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tjfinance.collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/taejin/Project/tj_finance/.venv/bin/python</string>
        <string>/Users/taejin/Project/tj_finance/scripts/collect_new.py</string>
        <!--
          auto = 마지막 성공 실행(pipeline_runs) 이후를 자동 회수. 3일 겹침·90일 상한.
          ※ 예전 값 `3`(고정)이 2026-07 의 21일 공백을 만든 직접 원인이다 —
            3일 넘는 장애가 나면 그 사이 공시를 영구 누락시키고 아무도 모른다.
        -->
        <string>--days</string>
        <string>auto</string>
        <!--
          download-only: 유니버스 갱신·탐지·다운로드·미러·완전성감사까지만.
          파싱/표준화/계층2·3 적재는 계층3 재설계 완료 후 이 플래그를 빼면 되살아난다
          (docs/plans/collection_pipeline_restore_2026-07-31.md §5.1 · Phase 5).
        -->
        <string>--download-only</string>
    </array>
    <!--
      ⓪ 유니버스 갱신(KRX OpenAPI+FDR)과 ⓪-3 상장폐지 판정은 이제 **기본 동작**이라
      플래그가 필요 없다. 예전엔 opt-in 이라 빼먹으면 신규 상장이 영원히 안 들어오고
      상장폐지 판정도 통째로 건너뛰었다.
      상장폐지는 DB 상태(delisting_status)만 자동 갱신하고 **원문 파일은 건드리지 않는다** —
      아카이브 이관은 scripts/delisting_manage.py --archive (수동).
    -->

    <key>WorkingDirectory</key>
    <string>/Users/taejin/Project/tj_finance</string>

    <!-- 매일 18:00 실행. 잠자기였다면 깨어난 직후 실행됨(누락 방지). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/taejin/Project/tj_finance/logs/collect.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/taejin/Project/tj_finance/logs/collect.err.log</string>
</dict>
</plist>
